HOARDER_PORT=8088
# Use 127.0.0.1 for local-only access or a Tailscale IP for tailnet-only access.
HOARDER_BIND_ADDRESS=0.0.0.0
HOARDER_DB_PASSWORD=replace-with-a-long-random-value
HOARDER_MEDIA_ROOT_1=/path/to/primary/media
HOARDER_MEDIA_ROOT_2=/path/to/secondary/media
# Container paths must match the mounts above. Add a .hoarder-root sentinel file to each host root.
HOARDER_STORAGE_ROOTS=[{"key":"primary","label":"Primary archive","path":"/media/primary","sentinel":".hoarder-root"},{"key":"secondary","label":"Secondary archive","path":"/media/secondary","sentinel":".hoarder-root"}]
